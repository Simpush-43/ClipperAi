{
  "name": "clipper",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "npm run build && node --env-file-if-exists=.env backend/server.js",
    "dev": "concurrently -k -n API,WEB -c green,cyan \"npm:api:dev\" \"npm:ui:dev\"",
    "api:dev": "node --watch --env-file=.env backend/server.js",
    "ui:dev": "vite --config frontend/vite.config.js --host 127.0.0.1",
    "build": "vite build --config frontend/vite.config.js",
    "dashboard": "npm run build && node --env-file=.env backend/server.js",
    "cleanup": "node --env-file=.env backend/cleanup-expired.js",
    "clips": "node --env-file=.env clip.js",
    "test": "node --test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "argon2": "^0.45.1",
    "ffmpeg-static": "^5.3.0",
    "google-auth-library": "^11.3.0",
    "lucide-react": "^1.55.0",
    "mongodb": "^7.7.0",
    "nodemailer": "^10.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
}
